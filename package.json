{
  "name": "coffex-monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @coffex/api --filter @coffex/web dev",
    "dev:web": "pnpm --filter @coffex/web dev",
    "dev:api": "pnpm --filter @coffex/api dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @coffex/web build",
    "build:api": "pnpm --filter @coffex/api build",
    "test": "pnpm -r test",
    "test:web": "pnpm --filter @coffex/web test",
    "test:api": "pnpm --filter @coffex/api test",
    "test:e2e": "pnpm --filter @coffex/web test:e2e"
  }
}
